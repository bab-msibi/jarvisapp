<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.jarvis.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/admin/App/jarvisapp/scripts/jarvis-server.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/admin/App/jarvisapp</string>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart if it exits (crash, or port 3000 still taken by a manual `npm start`) -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>15</integer>
    <key>StandardOutPath</key>
    <string>/Users/admin/App/jarvisapp/scripts/jarvis-server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/admin/App/jarvisapp/scripts/jarvis-server.log</string>
</dict>
</plist>
