{
  "name": "jarvisapp",
  "version": "2.0.0",
  "private": true,
  "description": "Jarvis \u2014 local dashboard and API bridge for OpenClaw (Next.js)",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "prestart": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "mcp": "node mcp-server.js",
    "service:install": "scripts/jarvis-service.sh install",
    "service:uninstall": "scripts/jarvis-service.sh uninstall",
    "service:restart": "scripts/jarvis-service.sh restart",
    "service:status": "scripts/jarvis-service.sh status",
    "service:logs": "scripts/jarvis-service.sh logs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
